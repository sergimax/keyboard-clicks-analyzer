{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/shared/**/*.ts",
    "src/server/**/*.ts"
  ],
  "exclude": ["src/ui/**"]
}
