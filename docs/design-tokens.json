{
  "$schemaComment": "Portable design tokens for keyboard-heatmap — chrome + domain heatmap.",
  "meta": {
    "name": "keyboard-heatmap",
    "version": "1.2.0",
    "sources": [
      "src/ui/styles/tokens.css",
      "src/ui/styles/links.css",
      "src/ui/styles/app.css",
      "src/shared/heat.ts",
      "src/ui/color-mode.ts",
      "src/ui/components/AppHeader.tsx",
      "src/ui/components/PreferenceSwitch.tsx"
    ],
    "framework": "vite-react-css",
    "colorModes": ["light", "dark"]
  },
  "typography": {
    "fontFamily": {
      "body": "'Noto Sans', system-ui, sans-serif",
      "display": "'Onest', 'Noto Sans', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'IBM Plex Mono', monospace"
    },
    "brandNameWeight": 700,
    "proseLineHeight": 1.55,
    "appTitle": {
      "fontFamilyToken": "display",
      "fontSize": "1.15rem",
      "fontWeight": 700,
      "letterSpacing": "0.02em",
      "colorToken": "brand"
    },
    "sectionTitle": {
      "fontFamilyToken": "display",
      "fontSize": "1.15rem",
      "fontWeight": 700,
      "letterSpacing": "0.02em",
      "colorToken": "textStrong"
    },
    "button": {
      "fontWeight": 600,
      "textTransform": "none"
    },
    "keyLabel": {
      "fontSize": "0.7rem",
      "fontWeight": 700,
      "letterSpacing": "0.01em"
    },
    "keyCount": {
      "fontSize": "0.6rem",
      "fontWeight": 650,
      "fontVariantNumeric": "tabular-nums"
    },
    "rankItem": {
      "fontSize": "0.78rem",
      "lineHeight": 1.3,
      "fontVariantNumeric": "tabular-nums"
    },
    "mutedBody": {
      "fontSize": "0.9rem",
      "colorToken": "textMuted"
    }
  },
  "shape": {
    "controlBorderRadius": 8,
    "menuItemBorderRadius": 6,
    "panelBorderRadius": 10,
    "boardBorderRadius": 14,
    "dialogBorderRadius": 10,
    "menuBorderRadius": 10,
    "pillBorderRadius": 999,
    "focusOutlineRadius": 4,
    "gap": "0.55rem",
    "pad": "0.65rem",
    "boardGapPx": 6
  },
  "borders": {
    "width": "1px",
    "style": "solid",
    "defaultColor": "#8a8a8a",
    "interactiveMinContrast": 3
  },
  "spacingRecipes": {
    "toolbarGap": [12, 16],
    "toolbarPadding": "10px 20px",
    "mainPadding": "20px 20px 48px",
    "panelPadding": "10px 12px",
    "boardPadding": 14,
    "boardGap": 6,
    "controlsGap": [12, 20],
    "rankRowGap": 12,
    "modalPadding": "20px 22px",
    "modalActionsGap": 10
  },
  "shadows": {
    "card": {
      "light": "0 6px 18px rgba(0, 0, 0, 0.07)",
      "dark": "0 8px 24px rgba(0, 0, 0, 0.4)"
    },
    "keyLabelOnDarkHeat": "0 0 2px rgba(0,0,0,0.85), 0 1px 1px rgba(0,0,0,0.7)"
  },
  "shell": {
    "contentMaxWidthPx": 1400,
    "toolbarMinHeightPx": 56,
    "compactMenuBreakpointPx": 900,
    "appBarZIndex": 200,
    "menuZIndex": 220,
    "modalZIndex": 1000,
    "board": {
      "columnsWithNumpad": 24,
      "columnsWithoutNumpad": 19,
      "colMinMaxPx": [36, 42],
      "rowHeightPx": 44,
      "rows": 6
    }
  },
  "colorMode": {
    "modes": ["light", "dark"],
    "default": "light",
    "attribute": "data-theme",
    "preferenceStorageKey": "kca-color-mode",
    "preferenceStoragePrefix": "kca-"
  },
  "semantics": {
    "brandNotPrimary": true,
    "primaryIsInverseInk": true,
    "okIsGreen": true,
    "dangerIsRed": true,
    "brandDistinctFromDangerAndOk": true,
    "heatmapLegendFixed": ["#1c6052", "#d68440", "#b03a08"]
  },
  "cssVariables": {
    "light": {
      "--bg": "#fcfbf9",
      "--surface": "#ffffff",
      "--chip-bg": "#f3f2ef",
      "--header-bg": "rgba(252, 251, 249, 0.96)",
      "--border": "#8a8a8a",
      "--text": "#141414",
      "--text-strong": "#0a0a0a",
      "--text-muted": "#555555",
      "--brand": "#9a3412",
      "--brand-soft": "#fff7ed",
      "--brand-border": "#c2410c",
      "--ok": "#166534",
      "--ok-bg": "#ecfdf5",
      "--ok-border": "#166534",
      "--danger": "#dc2626",
      "--danger-bg": "#fef2f2",
      "--danger-border": "#dc2626",
      "--link": "#2c5282",
      "--link-spot": "#9a3412",
      "--primary-bg": "#0a0a0a",
      "--primary-border": "#0a0a0a",
      "--primary-fg": "#ffffff",
      "--shadow": "0 6px 18px rgba(0, 0, 0, 0.07)",
      "--key-bg": "#f3f2ef",
      "--key-border": "#8a8a8a",
      "--board-bg": "#f3f2ef",
      "--cold": "#1c6052",
      "--heat-mid": "#d68440",
      "--hot": "#b03a08"
    },
    "dark": {
      "--bg": "#1a1a1a",
      "--surface": "#242424",
      "--chip-bg": "#1f1f1f",
      "--header-bg": "rgba(26, 26, 26, 0.96)",
      "--border": "#8a8a8a",
      "--text": "#f2f2f2",
      "--text-strong": "#fafafa",
      "--text-muted": "#a3a3a3",
      "--brand": "#fb923c",
      "--brand-soft": "#3d2818",
      "--brand-border": "#fb923c",
      "--ok": "#86efac",
      "--ok-bg": "rgba(134, 239, 172, 0.12)",
      "--ok-border": "#86efac",
      "--danger": "#ff7b72",
      "--danger-bg": "rgba(255, 123, 114, 0.14)",
      "--danger-border": "#ff7b72",
      "--link": "#8ab4c8",
      "--link-spot": "#fb923c",
      "--primary-bg": "#fafafa",
      "--primary-border": "#fafafa",
      "--primary-fg": "#111111",
      "--shadow": "0 8px 24px rgba(0, 0, 0, 0.4)",
      "--key-bg": "#1f1f1f",
      "--key-border": "#8a8a8a",
      "--board-bg": "#1f1f1f",
      "--cold": "#1c6052",
      "--heat-mid": "#d68440",
      "--hot": "#b03a08"
    },
    "shared": {
      "--font-body": "'Noto Sans', system-ui, sans-serif",
      "--font-display": "'Onest', 'Noto Sans', system-ui, sans-serif",
      "--font-mono": "'JetBrains Mono', 'IBM Plex Mono', monospace",
      "--radius": "10px",
      "--control-radius": "8px",
      "--gap": "0.55rem",
      "--pad": "0.65rem",
      "--board-gap": "6px",
      "--panel": "var(--surface)",
      "--muted": "var(--text-muted)"
    }
  },
  "palette": {
    "light": {
      "bg": "#fcfbf9",
      "surface": "#ffffff",
      "chipBg": "#f3f2ef",
      "headerBg": "rgba(252, 251, 249, 0.96)",
      "border": "#8a8a8a",
      "text": "#141414",
      "textStrong": "#0a0a0a",
      "textMuted": "#555555",
      "brand": "#9a3412",
      "brandSoft": "#fff7ed",
      "brandBorder": "#c2410c",
      "ok": "#166534",
      "okBg": "#ecfdf5",
      "okBorder": "#166534",
      "danger": "#dc2626",
      "dangerBg": "#fef2f2",
      "dangerBorder": "#dc2626",
      "link": "#2c5282",
      "linkSpot": "#9a3412",
      "primaryBg": "#0a0a0a",
      "primaryBorder": "#0a0a0a",
      "primaryFg": "#ffffff",
      "shadow": "0 6px 18px rgba(0, 0, 0, 0.07)",
      "actionHover": "rgba(10, 10, 10, 0.04)",
      "modalBackdrop": "rgba(20, 20, 20, 0.4)"
    },
    "dark": {
      "bg": "#1a1a1a",
      "surface": "#242424",
      "chipBg": "#1f1f1f",
      "headerBg": "rgba(26, 26, 26, 0.96)",
      "border": "#8a8a8a",
      "text": "#f2f2f2",
      "textStrong": "#fafafa",
      "textMuted": "#a3a3a3",
      "brand": "#fb923c",
      "brandSoft": "#3d2818",
      "brandBorder": "#fb923c",
      "ok": "#86efac",
      "okBg": "rgba(134, 239, 172, 0.12)",
      "okBorder": "#86efac",
      "danger": "#ff7b72",
      "dangerBg": "rgba(255, 123, 114, 0.14)",
      "dangerBorder": "#ff7b72",
      "link": "#8ab4c8",
      "linkSpot": "#fb923c",
      "primaryBg": "#fafafa",
      "primaryBorder": "#fafafa",
      "primaryFg": "#111111",
      "shadow": "0 8px 24px rgba(0, 0, 0, 0.4)",
      "actionHover": "rgba(250, 250, 250, 0.06)",
      "modalBackdrop": "rgba(0, 0, 0, 0.6)"
    }
  },
  "linkStyles": {
    "quiet": {
      "colorToken": "link",
      "fontWeight": 500,
      "textDecorationThickness": "1px",
      "textUnderlineOffset": "3px"
    },
    "spot": {
      "className": "link-spot",
      "colorToken": "linkSpot",
      "fontFamilyToken": "display",
      "fontWeight": 700,
      "fontStyle": "italic",
      "textDecorationThickness": "2px",
      "textUnderlineOffset": "3px",
      "letterSpacing": "0.01em"
    }
  },
  "components": {
    "appBar": {
      "position": "sticky",
      "backdropFilter": "saturate(1.2) blur(12px)",
      "borderBottom": "1px solid var(--border)",
      "background": "var(--header-bg)",
      "layout": "brand-left | actions-center | meta-right",
      "compactBreakpointPx": 900,
      "metaIncludesThemeToggle": true,
      "logo": {
        "technique": "css-mask",
        "maskUrl": "/logo.svg",
        "colorToken": "brandBorder",
        "note": "Brighter orange than title --brand (readable text ink)"
      }
    },
    "btnToolbar": {
      "borderRadius": 8,
      "padding": "6px 12px",
      "fontSize": "0.85rem",
      "variants": {
        "default": "outlined border + textStrong",
        "primary": "inverse ink (--primary-*)",
        "danger": "danger soft fill + danger text"
      }
    },
    "btnIcon": {
      "sizePx": 36,
      "borderRadius": 8,
      "hoverBg": "var(--action-hover)"
    },
    "btnCopy": {
      "variant": "primary-ink",
      "borderRadius": 8
    },
    "preferenceSwitch": {
      "trackWidthPx": 36,
      "trackHeightPx": 20,
      "thumbSizePx": 14,
      "offTrack": "var(--chip-bg)",
      "onTrack": "var(--primary-bg)",
      "onBorder": "var(--primary-border)",
      "focusOutline": "2px solid var(--brand-border)"
    },
    "heatScaleSegmented": {
      "border": "var(--border)",
      "background": "var(--chip-bg)",
      "activeBackground": "var(--primary-bg)",
      "activeColor": "var(--primary-fg)"
    },
    "rankBlock": {
      "width": "15rem",
      "padding": "10px 12px",
      "background": "var(--surface)",
      "border": "1px solid var(--border)",
      "borderRadius": 10,
      "boxShadow": "var(--shadow)",
      "screenListLimit": 12,
      "copyLimit": 30
    },
    "modal": {
      "maxWidthPx": 420,
      "borderRadius": 10,
      "border": "1px solid var(--border)",
      "background": "var(--surface)",
      "titleDangerColor": "var(--danger)",
      "titleNeutralColor": "var(--text-strong)"
    },
    "input": {
      "borderRadius": 8,
      "border": "var(--border)",
      "background": "var(--chip-bg)",
      "focusBorder": "var(--brand-border)",
      "placeholder": "var(--text-muted)"
    },
    "keyCell": {
      "borderRadius": 8,
      "idleBackground": "var(--key-bg)",
      "idleBorder": "var(--key-border)",
      "idleUsesCssOnly": true
    }
  },
  "domain": {
    "comment": "Heatmap spectrum + ink contrast; omit when seeding an unrelated UI.",
    "heatmap": {
      "stops": {
        "idle": { "note": "Theme --key-bg (CSS); not heat-branded" },
        "cold": { "rgb": [28, 96, 82], "hex": "#1c6052", "cssVar": "--cold" },
        "mid": { "rgb": [214, 132, 64], "hex": "#d68440", "cssVar": "--heat-mid" },
        "hot": { "rgb": [176, 58, 8], "hex": "#b03a08", "cssVar": "--hot" }
      },
      "legendGradient": "linear-gradient(90deg, var(--cold), var(--heat-mid), var(--hot))",
      "scaleModes": ["absolute", "relative"],
      "absolute": "sqrt(count / max)",
      "relative": "percentile / rank intensity among pressed keys",
      "ink": {
        "lightLabel": [248, 250, 252],
        "darkLabel": [18, 14, 10],
        "lightCount": [220, 226, 235],
        "darkCount": [48, 36, 28],
        "warmBorder": "#4a3424",
        "coolBorder": "#2a4038",
        "idleBorder": "var(--key-border)",
        "rules": [
          "Warm mid/hot fills (high R vs B) prefer dark ink",
          "Contrast vs light/dark label picks readable ink",
          "Light ink on dark heat gets soft black text-shadow",
          "Idle keys use theme CSS vars (no inline heat style)"
        ]
      }
    },
    "preferenceKeys": {
      "colorMode": "kca-color-mode",
      "showNumpad": "kca-show-numpad",
      "showDiagnostics": "kca-show-side",
      "heatScale": "kca-heat-scale",
      "rankPairs": "kca-rank-pairs",
      "rankSelf": "kca-rank-self",
      "rankMods": "kca-rank-mods",
      "deviceMeta": "kca-device-meta"
    }
  },
  "contrast": {
    "textMin": 4.5,
    "borderMin": 3
  }
}
