{
  "$schemaComment": "Keyboard Heatmap design tokens — Super ★ chrome + domain heatmap. See docs/theme-super.json for the portable Super contract.",
  "meta": {
    "name": "keyboard-heatmap",
    "version": "2.0.0",
    "theme": "super",
    "sources": [
      "docs/theme-super.json",
      "src/ui/styles/tokens.css",
      "src/ui/styles/links.css",
      "src/ui/styles/app.css",
      "src/shared/heat.ts",
      "src/ui/color-mode.ts"
    ],
    "framework": "vite-react-css",
    "colorModes": ["light", "dark"],
    "defaultColorMode": "light"
  },
  "semantics": {
    "brandNotPrimary": true,
    "primaryIsInverseInk": true,
    "okIsGreen": true,
    "dangerIsRed": true,
    "brandDistinctFromDangerAndOk": true,
    "interactiveBorder": "#8a8a8a",
    "heatmapLegendFixed": ["#1c6052", "#d68440", "#b03a08"]
  },
  "typography": {
    "fontFamily": {
      "body": "'Noto Sans', 'Segoe UI', system-ui, sans-serif",
      "display": "'Onest', 'Noto Sans', 'Segoe UI', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'IBM Plex Mono', Consolas, monospace"
    },
    "brandNameWeight": 700,
    "proseLineHeight": 1.55,
    "webfontCdn": false,
    "note": "Offline app — no Google Fonts CDN; system fallbacks provide Cyrillic on Windows."
  },
  "shape": {
    "radius": "10px",
    "controlRadius": "8px",
    "gap": "0.55rem",
    "pad": "0.65rem",
    "boardGap": "6px",
    "boardBorderRadius": 14
  },
  "colorMode": {
    "htmlAttribute": "data-theme",
    "storageKey": "kca-color-mode",
    "themeColorMeta": {
      "light": "#fcfbf9",
      "dark": "#1a1a1a"
    }
  },
  "modes": {
    "light": {
      "bg": "#fcfbf9",
      "surface": "#ffffff",
      "chipBg": "#f3f2ef",
      "headerBg": "rgba(252, 251, 249, 0.96)",
      "border": "#8a8a8a",
      "text": "#141414",
      "textStrong": "#0a0a0a",
      "textMuted": "#555555",
      "brand": "#9a3412",
      "brandSoft": "#fff7ed",
      "brandBorder": "#c2410c",
      "ok": "#166534",
      "okBg": "#ecfdf5",
      "okBorder": "#166534",
      "danger": "#dc2626",
      "dangerBg": "#fef2f2",
      "dangerBorder": "#dc2626",
      "link": "#2c5282",
      "linkSpot": "#9a3412",
      "primaryBg": "#0a0a0a",
      "primaryBorder": "#0a0a0a",
      "primaryFg": "#ffffff",
      "shadow": "0 6px 18px rgba(0, 0, 0, 0.07)",
      "keyBg": "#f3f2ef",
      "keyBorder": "#8a8a8a",
      "boardBg": "#f3f2ef"
    },
    "dark": {
      "bg": "#1a1a1a",
      "surface": "#242424",
      "chipBg": "#1f1f1f",
      "headerBg": "rgba(26, 26, 26, 0.96)",
      "border": "#8a8a8a",
      "text": "#f2f2f2",
      "textStrong": "#fafafa",
      "textMuted": "#a3a3a3",
      "brand": "#fb923c",
      "brandSoft": "#3d2818",
      "brandBorder": "#fb923c",
      "ok": "#86efac",
      "okBg": "rgba(134, 239, 172, 0.12)",
      "okBorder": "#86efac",
      "danger": "#ff7b72",
      "dangerBg": "rgba(255, 123, 114, 0.14)",
      "dangerBorder": "#ff7b72",
      "link": "#8ab4c8",
      "linkSpot": "#fb923c",
      "primaryBg": "#fafafa",
      "primaryBorder": "#fafafa",
      "primaryFg": "#111111",
      "shadow": "0 8px 24px rgba(0, 0, 0, 0.4)",
      "keyBg": "#1f1f1f",
      "keyBorder": "#8a8a8a",
      "boardBg": "#1f1f1f"
    }
  },
  "linkStyles": {
    "quiet": {
      "colorToken": "link",
      "fontWeight": 500,
      "textDecorationThickness": "1px",
      "textUnderlineOffset": "3px"
    },
    "spot": {
      "className": "link-spot",
      "colorToken": "linkSpot",
      "fontFamilyToken": "display",
      "fontWeight": 700,
      "fontStyle": "italic",
      "textDecorationThickness": "2px"
    }
  },
  "shell": {
    "contentMaxWidthPx": 1400,
    "toolbarMinHeightPx": 56,
    "compactMenuBreakpointPx": 900
  },
  "domain": {
    "heatmap": {
      "stops": {
        "cold": "#1c6052",
        "mid": "#d68440",
        "hot": "#b03a08"
      },
      "legendGradient": "linear-gradient(90deg, var(--cold), var(--heat-mid), var(--hot))",
      "scaleModes": ["absolute", "relative"],
      "idleKeysUseThemeTokens": true
    },
    "preferenceKeys": {
      "colorMode": "kca-color-mode",
      "showNumpad": "kca-show-numpad",
      "showDiagnostics": "kca-show-side",
      "heatScale": "kca-heat-scale",
      "rankPairs": "kca-rank-pairs",
      "rankSelf": "kca-rank-self",
      "rankMods": "kca-rank-mods",
      "deviceMeta": "kca-device-meta"
    }
  }
}
