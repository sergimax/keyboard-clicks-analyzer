{
  "$schemaComment": "Portable design tokens extracted from keyboard-heatmap. Core tokens are app-agnostic chrome; domain.heatmap is product-specific.",
  "meta": {
    "name": "keyboard-heatmap",
    "version": "1.0.0",
    "sources": [
      "src/ui/styles/app.css",
      "src/shared/heat.ts",
      "src/ui/components/AppHeader.tsx",
      "src/ui/components/PreferenceSwitch.tsx"
    ],
    "framework": "vite-react-css",
    "colorModes": ["dark"]
  },
  "typography": {
    "fontFamily": "\"Segoe UI\", \"IBM Plex Sans\", system-ui, sans-serif",
    "monoFamily": "\"Cascadia Mono\", \"Cascadia Code\", Consolas, \"SF Mono\", \"Segoe UI Mono\", ui-monospace, monospace",
    "appTitle": {
      "fontSize": "1.15rem",
      "fontWeight": 650,
      "letterSpacing": "0.02em"
    },
    "sectionTitle": {
      "fontSize": "1.15rem",
      "fontWeight": 650,
      "letterSpacing": "0.02em"
    },
    "button": {
      "fontWeight": 600,
      "textTransform": "none"
    },
    "keyLabel": {
      "fontSize": "0.7rem",
      "fontWeight": 700,
      "letterSpacing": "0.01em"
    },
    "keyCount": {
      "fontSize": "0.6rem",
      "fontWeight": 650,
      "fontVariantNumeric": "tabular-nums"
    },
    "rankItem": {
      "fontSize": "0.78rem",
      "lineHeight": 1.3,
      "fontVariantNumeric": "tabular-nums"
    },
    "mutedBody": {
      "fontSize": "0.9rem",
      "colorToken": "textMuted"
    }
  },
  "shape": {
    "controlBorderRadius": 8,
    "menuItemBorderRadius": 6,
    "panelBorderRadius": 10,
    "boardBorderRadius": 14,
    "dialogBorderRadius": 10,
    "menuBorderRadius": 10,
    "pillBorderRadius": 999,
    "focusOutlineRadius": 4
  },
  "borders": {
    "width": "1px",
    "style": "solid",
    "defaultColor": "#2a3140",
    "controlColor": "#3a4456",
    "controlHoverColor": "#5a6a82",
    "accentColor": "#2f9e82",
    "accentHoverColor": "#3db894",
    "dangerColor": "#5a4030",
    "dangerStrongColor": "#8a3a2a",
    "dangerHoverColor": "#e85d04"
  },
  "spacingRecipes": {
    "toolbarGap": [12, 16],
    "toolbarPadding": "10px 20px",
    "mainPadding": "20px 20px 48px",
    "panelPadding": "10px 12px",
    "boardPadding": 14,
    "boardGap": 6,
    "controlsGap": [12, 20],
    "rankRowGap": 12,
    "modalPadding": "20px 22px",
    "modalActionsGap": 10
  },
  "shadows": {
    "menu": "0 10px 28px rgba(0, 0, 0, 0.35)",
    "dialog": "0 16px 48px rgba(0, 0, 0, 0.45)",
    "keyLabelOnDarkHeat": "0 0 2px rgba(0,0,0,0.85), 0 1px 1px rgba(0,0,0,0.7)"
  },
  "shell": {
    "contentMaxWidthPx": 1400,
    "toolbarMinHeightPx": 56,
    "compactMenuBreakpointPx": 900,
    "appBarZIndex": 200,
    "menuZIndex": 220,
    "modalZIndex": 1000,
    "board": {
      "columnsWithNumpad": 24,
      "columnsWithoutNumpad": 19,
      "colMinMaxPx": [36, 42],
      "rowHeightPx": 44,
      "rows": 6
    }
  },
  "colorMode": {
    "modes": ["dark"],
    "note": "Single dark theme only; no data-color-mode toggle.",
    "preferenceStoragePrefix": "kca-"
  },
  "cssVariables": {
    "dark": {
      "--bg": "#12151a",
      "--panel": "#1a1f27",
      "--text": "#e8edf5",
      "--muted": "#8b95a8",
      "--key-bg": "#252b36",
      "--key-border": "#343c4a",
      "--cold": "#1c6052",
      "--hot": "#b03a08",
      "--gap": "6px"
    }
  },
  "palette": {
    "dark": {
      "text": { "primary": "#e8edf5", "muted": "#8b95a8", "soft": "#c5cddb", "legendEnd": "#c5cedd", "placeholder": "#5a6578" },
      "background": {
        "page": "#12151a",
        "panel": "#1a1f27",
        "board": "#141820",
        "input": "#141820",
        "segmented": "#1a2030",
        "control": "#222a3a",
        "controlHover": "#2a3348",
        "appBar": "rgba(26, 31, 39, 0.72)",
        "modal": "#1a1520",
        "modalBackdrop": "rgba(8, 10, 14, 0.72)"
      },
      "divider": "#2a3140",
      "controlBorder": "#3a4456",
      "key": { "bg": "#252b36", "border": "#343c4a" },
      "accent": {
        "main": "#1f6f5b",
        "border": "#2f9e82",
        "borderHover": "#3db894",
        "fill": "#1a2e28",
        "fillHover": "#234038",
        "fg": "#b8e0d4"
      },
      "danger": {
        "border": "#5a4030",
        "borderStrong": "#8a3a2a",
        "borderHover": "#e85d04",
        "fill": "#3a1c18",
        "fillHover": "#4a2418",
        "toolbarFillHover": "#3a2a20",
        "fg": "#f4a261",
        "fgSoft": "#ffb4a2",
        "fgHot": "#ffd4a8"
      },
      "action": {
        "hover": "rgba(232, 237, 245, 0.08)"
      }
    }
  },
  "atmosphere": {
    "dark": "radial-gradient(1200px 600px at 10% -10%, #1e3a34 0%, transparent 55%), radial-gradient(900px 500px at 100% 0%, #3a2418 0%, transparent 50%), var(--bg)",
    "note": "Fixed teal + warm radial washes on body over --bg"
  },
  "components": {
    "appBar": {
      "position": "sticky",
      "backdropFilter": "saturate(1.2) blur(12px)",
      "borderBottom": "1px solid #2a3140",
      "layout": "brand-left | actions-center | meta-right",
      "compactBreakpointPx": 900
    },
    "btnToolbar": {
      "borderRadius": 8,
      "padding": "6px 12px",
      "fontSize": "0.85rem",
      "border": "#3a4456",
      "color": "#c5cddb",
      "hoverAccent": true
    },
    "btnIcon": {
      "sizePx": 36,
      "borderRadius": 8,
      "hoverBg": "rgba(232, 237, 245, 0.08)"
    },
    "btnCopy": {
      "variant": "accent-outlined-fill",
      "borderRadius": 8
    },
    "preferenceSwitch": {
      "trackWidthPx": 36,
      "trackHeightPx": 20,
      "thumbSizePx": 14,
      "offTrack": "#2a3140",
      "onTrack": "#1f6f5b",
      "onBorder": "#2f9e82",
      "focusOutline": "2px solid #2f9e82"
    },
    "heatScaleSegmented": {
      "border": "#3a4456",
      "background": "#1a2030",
      "activeBackground": "#1f6f5b",
      "activeColor": "#e8edf5"
    },
    "rankBlock": {
      "width": "15rem",
      "padding": "10px 12px",
      "background": "var(--panel)",
      "border": "1px solid #2a3140",
      "borderRadius": 10,
      "screenListLimit": 12,
      "copyLimit": 30
    },
    "modal": {
      "maxWidthPx": 420,
      "borderRadius": 10,
      "border": "1px solid #5a4030",
      "background": "#1a1520",
      "titleDangerColor": "#ffd4a8",
      "titleNeutralColor": "#e8edf5"
    },
    "input": {
      "borderRadius": 8,
      "border": "#3a4456",
      "background": "#141820",
      "focusBorder": "#2f9e82",
      "placeholder": "#5a6578"
    },
    "keyCell": {
      "borderRadius": 8,
      "idleBackground": "var(--key-bg)",
      "idleBorder": "var(--key-border)"
    }
  },
  "domain": {
    "comment": "Heatmap spectrum + ink contrast; omit when seeding an unrelated UI.",
    "heatmap": {
      "stops": {
        "idle": { "rgb": [37, 43, 54], "hex": "#252b36" },
        "cold": { "rgb": [28, 96, 82], "hex": "#1c6052", "cssVar": "--cold" },
        "mid": { "rgb": [214, 132, 64], "hex": "#d68440" },
        "hot": { "rgb": [176, 58, 8], "hex": "#b03a08", "cssVar": "--hot" }
      },
      "legendGradient": "linear-gradient(90deg, var(--cold), #d68440, var(--hot))",
      "scaleModes": ["absolute", "relative"],
      "absolute": "sqrt(count / max)",
      "relative": "percentile / rank intensity among pressed keys",
      "ink": {
        "lightLabel": [248, 250, 252],
        "darkLabel": [18, 14, 10],
        "lightCount": [220, 226, 235],
        "darkCount": [48, 36, 28],
        "warmBorder": "#4a3424",
        "coolBorder": "#2a4038",
        "idleBorder": "#343c4a",
        "rules": [
          "Warm mid/hot fills (high R vs B) prefer dark ink",
          "Contrast vs light/dark label picks readable ink",
          "Light ink on dark heat gets soft black text-shadow"
        ]
      }
    },
    "preferenceKeys": {
      "showNumpad": "kca-show-numpad",
      "showDiagnostics": "kca-show-side",
      "heatScale": "kca-heat-scale",
      "rankPairs": "kca-rank-pairs",
      "rankSelf": "kca-rank-self",
      "rankMods": "kca-rank-mods",
      "deviceMeta": "kca-device-meta"
    }
  }
}
