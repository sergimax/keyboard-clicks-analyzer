{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["../shared/*"],
      "@keymap": ["../keymap.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../shared/**/*.ts", "../keymap.ts"]
}
